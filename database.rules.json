{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": false,
      ".write": false,
      "$roomId": {
        ".read": true,
        ".write": false,
        ".validate": "$roomId.length >= 3 && $roomId.length <= 40",
        "hostUid": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "capacity": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 12"
        },
        "allowPlayerHammer": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "rotateAuctioneer": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "auctioneerBusy": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "teams": {
          ".write": true,
          "$teamId": {
            ".validate": "newData.val() == null || (newData.child('budget').isNumber() && newData.child('budget').val() >= 0 && newData.child('budget').val() <= 10000)"
          }
        },
        "auction": {
          ".write": true,
          "$playerId": {
            ".validate": "newData.val() == null || newData.hasChildren()",
            "currentBid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "highestBidder": {
              ".validate": "newData.isString() || newData.val() == null"
            },
            "highestBidderTeam": {
              ".validate": "newData.isString() || newData.val() == null"
            },
            "status": {
              ".validate": "newData.val() == 'sold' || newData.val() == 'unsold' || newData.val() == null"
            },
            "optOuts": {
              ".write": true
            }
          }
        },
        "global": {
          ".write": true,
          "activePlayerId": {
            ".validate": "newData.isNumber() || newData.val() == null"
          },
          "timerEndsAt": {
            ".validate": "newData.isNumber() || newData.val() == null"
          },
          "activityLog": {
            ".write": true,
            "$logId": {
              ".validate": "newData.hasChildren(['time', 'text'])"
            }
          }
        },
        "chat": {
          ".write": true,
          "$msgId": {
            ".validate": "newData.hasChildren(['sender', 'message', 'timestamp']) && newData.child('message').isString() && newData.child('message').val().length <= 300"
          }
        }
      }
    }
  }
}
