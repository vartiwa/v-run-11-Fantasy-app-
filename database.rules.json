{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": false,
        "hostUid": {
          ".write": "!data.exists() || data.val() == newData.val()",
          ".validate": "newData.isString()"
        },
        "capacity": {
          ".write": "!data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 12"
        },
        "teams": {
          "$teamId": {
            ".write": true,
            ".validate": "newData.hasChildren(['budget'])",
            "ownerUid": {
              ".validate": "newData.isString()"
            },
            "budget": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            }
          }
        },
        "auction": {
          "$playerId": {
            ".write": true,
            "currentBid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && (!data.exists() || newData.val() >= data.val())"
            },
            "status": {
              ".validate": "newData.val() == 'sold' || newData.val() == 'unsold' || newData.val() == null"
            }
          }
        },
        "chat": {
          "$msgId": {
            ".write": true,
            ".validate": "newData.hasChildren(['sender', 'message', 'timestamp']) && newData.child('message').val().length <= 150"
          }
        },
        "global": {
          ".write": true,
          "timerEndsAt": {
            ".validate": "newData.isNumber() || newData.val() == null"
          },
          "activePlayerId": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
